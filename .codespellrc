[codespell]
skip = .git,node_modules,dist,playwright-report*,test-results,*.pdf,*.svg,po,configure.ac,*.sln,*.rtf,Info.plist,package-lock.json,./src/i18n/locales/*,./scripts/generate-i18n-catalogs.mjs,./scripts/i18n-web-overrides.mjs,./scripts/generate-seo-locales.mjs,./ar/*,./de/*,./fr/*,./he/*
# gir - name of project
# aCount,wll,rightt - variables
# afterAll - Playwright/vitest lifecycle hook, not two words
# restor - deliberate regex stem in build-translation-review.mjs: it has to match
#   "restoring" as well as "restored", which the full word "restore" would not
ignore-words-list = gir,acount,wll,rightt,addin,Addin,initialy,localy,redy,afterAll,restor
