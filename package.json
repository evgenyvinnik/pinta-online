{
  "name": "pinta-online",
  "private": true,
  "version": "1.0.260825.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "i18n:sync": "node scripts/generate-i18n-catalogs.mjs",
    "verify:i18n": "node scripts/generate-i18n-catalogs.mjs --check",
    "seo:sync": "node scripts/generate-seo-locales.mjs",
    "verify:seo": "node scripts/generate-seo-locales.mjs --check",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "sloc": "node scripts/calc-sloc.mjs",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update",
    "test:visual:container": "npm run test:visual:typecheck && playwright test",
    "test:visual:typecheck": "tsc -p tests/visual/tsconfig.json",
    "test:visual:local": "playwright test",
    "test:visual:local:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:visual:report": "playwright show-report",
    "test:visual:review": "node scripts/build-visual-review.mjs",
    "test:visual:native": "node scripts/run-native-captures.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:e2e:container": "npm run test:e2e:typecheck && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:typecheck": "tsc -p tests/e2e/tsconfig.json",
    "test:e2e:local": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:report": "playwright show-report playwright-report-e2e",
    "verify:effects": "node scripts/verify-effects.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:openraster": "node --no-warnings --experimental-strip-types scripts/verify-openraster.ts",
    "verify:palette": "node --no-warnings --experimental-strip-types scripts/verify-palette.ts",
    "verify:image-codecs": "node --no-warnings --experimental-strip-types scripts/verify-image-codecs.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "i18next": "^26.4.0",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.12",
    "vite": "latest",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "gettext-parser": "^9.1.1",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
