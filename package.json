{
  "name": "pinta-online",
  "private": true,
  "version": "1.0.260829.33",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "i18n:sync": "node scripts/generate-i18n-catalogs.mjs",
    "verify:i18n": "node scripts/generate-i18n-catalogs.mjs --check",
    "seo:sync": "node scripts/generate-seo-locales.mjs",
    "verify:seo": "node scripts/generate-seo-locales.mjs --check",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run lint && npm run lint:eslint && npm run test:unit && npm run test:e2e:local",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "sloc": "node scripts/calc-sloc.mjs",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update",
    "test:visual:container": "npm run test:visual:typecheck && playwright test",
    "test:visual:typecheck": "tsc -p tests/visual/tsconfig.json",
    "test:visual:local": "playwright test",
    "test:visual:local:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:visual:report": "playwright show-report",
    "test:visual:review": "node scripts/build-visual-review.mjs",
    "test:visual:native": "node scripts/run-native-captures.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:e2e:container": "npm run test:e2e:typecheck && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:typecheck": "tsc -p tests/e2e/tsconfig.json",
    "test:e2e:local": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:report": "playwright show-report playwright-report-e2e",
    "test:performance": "node scripts/run-performance-tests.mjs",
    "test:performance:container": "npm run test:performance:typecheck && playwright test --config=playwright.performance.config.ts",
    "test:performance:local": "playwright test --config=playwright.performance.config.ts",
    "test:performance:typecheck": "tsc -p tests/performance/tsconfig.json",
    "verify:effects": "vitest run tests/unit/effects.test.ts",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:openraster": "vitest run tests/unit/openRaster.test.ts",
    "verify:palette": "vitest run tests/unit/palette.test.ts",
    "verify:image-codecs": "vitest run tests/unit/imageCodecs.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "i18next": "^26.4.0",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.12",
    "utif": "^3.1.0",
    "vite": "latest",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/utif": "^3.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "gettext-parser": "^9.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "typescript-eslint": "^8.68.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  }
}
