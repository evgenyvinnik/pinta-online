{
  "name": "pinta-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update",
    "test:visual:container": "npm run test:visual:typecheck && playwright test",
    "test:visual:typecheck": "tsc -p tests/visual/tsconfig.json",
    "test:visual:local": "playwright test",
    "test:visual:local:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:visual:report": "playwright show-report",
    "test:visual:review": "node scripts/build-visual-review.mjs",
    "verify:effects": "node scripts/verify-effects.mjs",
    "verify:openraster": "node --no-warnings --experimental-strip-types scripts/verify-openraster.ts",
    "verify:palette": "node --no-warnings --experimental-strip-types scripts/verify-palette.ts",
    "verify:image-codecs": "node --no-warnings --experimental-strip-types scripts/verify-image-codecs.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
